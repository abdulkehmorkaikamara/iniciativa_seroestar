# Backend environment variables for FastAPI / PostgreSQL
ENVIRONMENT=development
# Leave DATABASE_URL empty for local development and the backend stores data in
# backend/data/seroestar.db, which persists across restarts and reboots. Point
# it at PostgreSQL for any shared or deployed environment.
DATABASE_URL=
# Required in production (min 48 chars). Locally, a stable key is generated
# once into backend/data/.jwt_secret so sessions survive a restart.
JWT_SECRET=
# Legacy aliases for SEED_DEVELOPER_EMAIL / SEED_DEVELOPER_PASSWORD. They seed
# the root developer account; they are never accepted as a login by themselves.
ADMIN_EMAIL=developer@seroestar.com
ADMIN_PASSWORD=
DAILY_API_KEY=
DAILY_DOMAIN=seroestar.daily.co
FRONTEND_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
BLOB_READ_WRITE_TOKEN=
RECORDING_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=admin@seroestar.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM_NAME="Iniciativa Ser o Estar"
SMTP_FROM_EMAIL=admin@seroestar.com

# Optional: set this if you want to run the backend from a different root path
# OPENAI_API_KEY=
